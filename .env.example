# Northline RCA Environment Configuration
# Copy this file to `.env` in the repository root. Never commit secrets.

# GROQ API Key
# Optional: Set your Groq API key for live LangGraph model inference.
# If left empty, the application runs in honest Pre-validated Pharmaceutical Demo Mode.
GROQ_API_KEY=

# Groq Model ID (Default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Database URL
# PostgreSQL (Production / Docker): matches docker-compose.yml (host port 54329 -> container 5432)
DATABASE_URL=postgresql+psycopg://rca:rca@localhost:54329/rca
# Local SQLite fallback (if Docker / PostgreSQL is not running):
# DATABASE_URL=sqlite+pysqlite:///rca.db

# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:41731,http://127.0.0.1:41731
